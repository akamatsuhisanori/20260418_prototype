# ============================================================
# Re:roots Nuxt — 環境変数サンプル
# 本番は Vercel の Environment Variables 側に登録する
# ローカル用には `.env.local` にコピーして実値を埋める
# ============================================================

# Supabase project（公開しても問題ない値）
# Settings → API で取得
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_public_key_here

# ↓↓↓ ここから下は絶対にクライアントに漏らさない ↓↓↓

# Supabase service_role key（Settings → API で取得）
# Vercel では Sensitive にチェックし、Server 環境にのみ置く
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here

# admin になるメールアドレス（あなた自身のメール）
# このメールで最初にログインするとサーバー側で is_admin にフラグ付けされる
ADMIN_EMAIL=you@example.com

# supabase gen types 実行時に使う（ローカル開発のみ）
SUPABASE_PROJECT_ID=your-project-ref
