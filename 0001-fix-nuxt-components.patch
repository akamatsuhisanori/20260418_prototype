From e6a4b9d06eacdde80dab3144fe732d5180ef1ba8 Mon Sep 17 00:00:00 2001
From: Hisanori Akamatsu <akamatsuhisanoribb@gmail.com>
Date: Sat, 18 Apr 2026 13:42:45 +0900
Subject: [PATCH] fix(nuxt): flatten components auto-import so
 Step0/ProgressBar resolve

Nuxt 3 prefixes subfolder components by default (StepsStep0,
BaseProgressBar). assessment.vue uses bare <Step0 /> / <ProgressBar />,
so the page rendered empty. Setting pathPrefix: false restores the
unprefixed names.

Co-Authored-By: Claude Opus 4 <noreply@anthropic.com>
---
 nuxt.config.ts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/nuxt.config.ts b/nuxt.config.ts
index 49edeab..b89a1b0 100644
--- a/nuxt.config.ts
+++ b/nuxt.config.ts
@@ -7,6 +7,10 @@ export default defineNuxtConfig({
 
   modules: ["@nuxtjs/supabase"],
 
+  // Flatten component auto-import so <Step0 /> / <ProgressBar /> work
+  // without the folder-name prefix (StepsStep0 / BaseProgressBar).
+  components: [{ path: "~/components", pathPrefix: false }],
+
   supabase: {
     // @nuxtjs/supabase picks up SUPABASE_URL / SUPABASE_KEY (anon) from env
     redirectOptions: {
-- 
2.34.1

